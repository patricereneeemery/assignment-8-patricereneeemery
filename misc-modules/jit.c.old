/*
 * jit.c -- the just-in-time module from LDD3, adapted for modern proc_ops
 */

#include <linux/module.h>
#include <linux/moduleparam.h>
#include <linux/init.h>

#include <linux/sched.h>
#include <linux/kernel.h>
#include <linux/fs.h>     /* everything... */
#include <linux/proc_fs.h>
#include <linux/seq_file.h>
#include <linux/errno.h>  /* error codes */
#include <linux/workqueue.h>
#include <linux/preempt.h>
#include <linux/interrupt.h> /* tasklets */
#include <linux/timer.h>

MODULE_LICENSE("Dual BSD/GPL");

/*
 * Parameters and constants
 */
static int delay = HZ;      /* default delay */
module_param(delay, int, 0);

#define JIT_ASYNC   0
#define JIT_SCHED   1
#define JIT_QUEUE   2
#define JIT_SCHEDTO 3
#define JIT_BUSY    4

/*
 * Data structures
 */
static struct timer_list jit_timer;
static struct tasklet_struct jit_tasklet;
static wait_queue_head_t jit_wait;

/*
 * Simple jiffies-based function
 */
int jit_fn_show(struct seq_file *m, void *v)
{
        unsigned long j1 = jiffies;
        unsigned long j2;

        seq_printf(m, "jiffies: %lu\n", j1);
        j2 = jiffies;
        seq_printf(m, "delta:   %lu\n", j2 - j1);

        return 0;
}

static int jit_fn_open(struct inode *inode, struct file *file)
{
        return single_open(file, jit_fn_show, PDE_DATA(inode));
}

static const struct file_operations jit_fn_fops = {
        .open           = jit_fn_open,
        .read           = seq_read,
        .llseek         = seq_lseek,
        .release        = single_release,
};

static const struct proc_ops jit_fn_pops = {
        .proc_open      = jit_fn_open,
        .proc_read      = seq_read,
        .proc_lseek     = seq_lseek,
        .proc_release   = single_release,
};

/*
 * currentime
 */
int jit_currentime_show(struct seq_file *m, void *v)
{
        struct timespec64 tv;

        ktime_get_real_ts64(&tv);
        seq_printf(m, "%lu.%09lu\n", (unsigned long)tv.tv_sec,
                   (unsigned long)tv.tv_nsec);
        return 0;
}

static int jit_currentime_open(struct inode *inode, struct file *file)
{
        return single_open(file, jit_currentime_show, NULL);
}

static const struct file_operations jit_currentime_fops = {
        .open           = jit_currentime_open,
        .read           = seq_read,
        .llseek         = seq_lseek,
        .release        = single_release,
};

static const struct proc_ops jit_currentime_pops = {
        .proc_open      = jit_currentime_open,
        .proc_read      = seq_read,
        .proc_lseek     = seq_lseek,
        .proc_release   = single_release,
};

/*
 * Timer-based output
 */
void jit_timer_fn(struct timer_list *t)
{
        wake_up_interruptible(&jit_wait);
}

int jit_timer_show(struct seq_file *m, void *v)
{
        unsigned long j1 = jiffies;

        seq_printf(m, "timer start: %lu\n", j1);

        timer_setup(&jit_timer, jit_timer_fn, 0);
        jit_timer.expires = j1 + delay;
        add_timer(&jit_timer);

        wait_event_interruptible(jit_wait, 0);
        del_timer_sync(&jit_timer);

        seq_printf(m, "timer end:   %lu\n", jiffies);
        return 0;
}

static int jit_timer_open(struct inode *inode, struct file *file)
{
        return single_open(file, jit_timer_show, NULL);
}

static const struct file_operations jit_timer_fops = {
        .open           = jit_timer_open,
        .read           = seq_read,
        .llseek         = seq_lseek,
        .release        = single_release,
};

static const struct proc_ops jit_timer_pops = {
        .proc_open      = jit_timer_open,
        .proc_read      = seq_read,
        .proc_lseek     = seq_lseek,
        .proc_release   = single_release,
};

/*
 * Tasklet-based output
 */
void jit_tasklet_fn(unsigned long arg)
{
        wake_up_interruptible(&jit_wait);
}

int jit_tasklet_show(struct seq_file *m, void *v)
{
        unsigned long j1 = jiffies;

        seq_printf(m, "tasklet start: %lu\n", j1);

        tasklet_init(&jit_tasklet, jit_tasklet_fn, 0);
        tasklet_schedule(&jit_tasklet);

        wait_event_interruptible(jit_wait, 0);
        tasklet_kill(&jit_tasklet);

        seq_printf(m, "tasklet end:   %lu\n", jiffies);
        return 0;
}

static int jit_tasklet_open(struct inode *inode, struct file *file)
{
        return single_open(file, jit_tasklet_show, NULL);
}

static const struct file_operations jit_tasklet_fops = {
        .open           = jit_tasklet_open,
        .read           = seq_read,
        .llseek         = seq_lseek,
        .release        = single_release,
};

static const struct proc_ops jit_tasklet_pops = {
        .proc_open      = jit_tasklet_open,
        .proc_read      = seq_read,
        .proc_lseek     = seq_lseek,
        .proc_release   = single_release,
};

/*
 * init/cleanup
 */
int __init jit_init(void)
{
        init_waitqueue_head(&jit_wait);

        proc_create("currentime", 0, NULL, &jit_currentime_pops);

        proc_create_data("jitbusy", 0, NULL, &jit_fn_pops, (void *)JIT_BUSY);
        proc_create_data("jitsched", 0, NULL, &jit_fn_pops, (void *)JIT_SCHED);
        proc_create_data("jitqueue", 0, NULL, &jit_fn_pops, (void *)JIT_QUEUE);
        proc_create_data("jitschedto", 0, NULL, &jit_fn_pops, (void *)JIT_SCHEDTO);

        proc_create("jitimer", 0, NULL, &jit_timer_pops);
        proc_create("jitasklet", 0, NULL, &jit_tasklet_pops);
        proc_create_data("jitasklethi", 0, NULL, &jit_tasklet_pops, (void *)1);

        return 0;
}

void __exit jit_cleanup(void)
{
        remove_proc_entry("currentime", NULL);
        remove_proc_entry("jitbusy", NULL);
        remove_proc_entry("jitsched", NULL);
        remove_proc_entry("jitqueue", NULL);
        remove_proc_entry("jitschedto", NULL);
        remove_proc_entry("jitimer", NULL);
        remove_proc_entry("jitasklet", NULL);
        remove_proc_entry("jitasklethi", NULL);
}

module_init(jit_init);
module_exit(jit_cleanup);
